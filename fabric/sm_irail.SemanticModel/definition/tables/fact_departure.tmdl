table fact_departure
	lineageTag: e7df12ec-1c87-4dd9-ac52-245164a82c03
	sourceLineageTag: [dbo].[fact_departure]

	measure Departures = COUNTROWS(fact_departure)
		formatString: 0
		displayFolder: Measures
		lineageTag: e0698432-d97f-4234-a499-05d3c95199d2

		changedProperty = Name

		changedProperty = DisplayFolder

	measure 'Avg delay (min)' =
			
			CALCULATE(AVERAGE(fact_departure[delay_minutes]), fact_departure[is_cancelled] = FALSE())
		formatString: 0.0
		displayFolder: Measures
		lineageTag: cea8bcb2-54e5-4f13-8131-6af9ef17d2f4

		changedProperty = Name

		changedProperty = FormatString

		changedProperty = DisplayFolder

	measure 'Median delay (min)' =
			
			CALCULATE(MEDIAN(fact_departure[delay_minutes]), fact_departure[is_cancelled] = FALSE())
		formatString: 0.0
		displayFolder: Measures
		lineageTag: 0d0179aa-c431-4d84-9f35-5f9c1fdc78d1

		changedProperty = Name

		changedProperty = FormatString

		changedProperty = DisplayFolder

	measure 'On-time %' =
			
			DIVIDE(CALCULATE([Departures], fact_departure[is_on_time] = TRUE()), [Departures])
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Measures
		lineageTag: e734ca2a-c782-4b23-a45a-718250bae7e1

		changedProperty = Name

		changedProperty = FormatString

		changedProperty = DisplayFolder

	measure 'Delayed 5+ min %' =
			
			DIVIDE(CALCULATE([Departures], fact_departure[delay_minutes] >= 5), [Departures])
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Measures
		lineageTag: 03f2cc8c-3b9d-4b6e-b81c-a9bcb94c6c70

		changedProperty = Name

		changedProperty = FormatString

		changedProperty = DisplayFolder

	measure 'Cancelled %' =
			
			DIVIDE(CALCULATE([Departures], fact_departure[is_cancelled] = TRUE()), [Departures])
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Measures
		lineageTag: 9a7bfeb7-b473-4a32-b23f-9aeb014a0a66

		changedProperty = Name

		changedProperty = FormatString

		changedProperty = DisplayFolder

	measure 'Platform changes' =
			
			CALCULATE([Departures], fact_departure[platform_changed] = TRUE())
		formatString: 0
		displayFolder: Measures
		lineageTag: b638461e-5f32-4271-a19f-99e74f4d877a

		changedProperty = Name

		changedProperty = DisplayFolder

	measure 'Punctuality (NMBS, <6 min)' =
			
			DIVIDE(
			    CALCULATE([Departures], fact_departure[delay_minutes] < 6, fact_departure[is_cancelled] = FALSE()),
			    [Departures]
			)
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Measures
		lineageTag: 305d96aa-64b7-4193-9c50-15f551367320

		changedProperty = Name

		changedProperty = FormatString

		changedProperty = DisplayFolder

